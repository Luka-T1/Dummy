+        // prosek ocena iz svih kupovina posetioca
+        public void IzracunajProsecnuOcenu()
+        {
+            if (ListaKupovina.Count == 0)
+            {
+                ProsecnaOcenaRecenzija = 0;
+                return;
+            }
+
+            int zbir = 0;
+            foreach (Kupovina kupovina in ListaKupovina)
+            {
+                zbir += kupovina.Ocena;
+            }
+            ProsecnaOcenaRecenzija = (double)zbir / ListaKupovina.Count;
+        }
+
