+
+        // isto sto radi Povezivanje posle ucitavanja, samo za jednu knjigu
+        private void PoveziVeze(Knjiga knjiga)
+        {
+            foreach (Autor autor in knjiga.Autori)
+            {
+                autor.Knjige.Add(knjiga);
+            }
+
+            if (knjiga.Izdavac != null)
+            {
+                knjiga.Izdavac.Knjige.Add(knjiga);
+                foreach (Autor autor in knjiga.Autori)
+                {
+                    if (!knjiga.Izdavac.Autori.Contains(autor))
+                    {
+                        knjiga.Izdavac.Autori.Add(autor);
+                    }
+                }
+            }
+        }
+
+        private void RaskiniVeze(Knjiga knjiga)
+        {
+            foreach (Autor autor in knjiga.Autori)
+            {
+                autor.Knjige.Remove(knjiga);
+            }
+
+            if (knjiga.Izdavac != null)
+            {
+                knjiga.Izdavac.Knjige.Remove(knjiga);
+                // autor ostaje kod izdavaca samo ako ima jos neku knjigu kod njega
+                foreach (Autor autor in knjiga.Autori)
+                {
+                    bool imaJos = knjiga.Izdavac.Knjige.Exists(k => k.Autori.Contains(autor));
+                    if (!imaJos)
+                    {
+                        knjiga.Izdavac.Autori.Remove(autor);
+                    }
+                }
+            }
+        }
     }
